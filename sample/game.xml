<?xml version="1.0" encoding="UTF-8"?>
<game debug="false">
    <welcome>**** Welcome to 1984: Eyes of the State ****</welcome> 
    
    <auxiliaryMessages>
        <!-- Auxiliary messages handle structural grammar logic that simple key-value pairs can't -->
        <message type="BELONGS" 
                 selectorTag="plural" 
                 noMatch=":1 doesn't belong in :2." 
                 match=":1 don't belong in :2."/>
        <message type="TRADE" 
                 selectorTag="plural" 
                 noMatch="I've got :1 if you want, I'll do it for :2.|I've gor :1 if you're interested. I'll do it for :2."
                 match="I've got :1 if you like. I'll do them for :2."/>
        <message type="PRICE" 
                 selectorTag="plural" 
                 noMatch="It's worth :1."
                 match="They're worth :1."/>
        <!--        
        <message type="LOOK" 
                 selectorTag="remote-viewable"
                 noMatch="What do you want to :1?"
                 match="It's too far away to see clearly."
        -->        
    </auxiliaryMessages>
    
    <!--
    <player inventory="1|-101" startRoom="1" timeout="5" skiptime="10" hp="100" onDeathEvent="500000" quitGameNpc="99999"/>   
    -->
    <player inventory="-101|1|23|24|101|400|412|403|404|405|409|432|511|517|23|24|25|432|410|414|505|506" startRoom="1" timeout="5" skiptime="10" hp="100" onDeathEvent="500000"/>    
   
    <currency major="Dollars" minor="Cents" symbol="$" initialBalance="0"/>
    <gameClock type="24" startTime="18:00"/>
    
    <!--
        Uncomment this to enable 16 point compass directions. 
        You can add 32 point directions here too. You map the actual verbs
        below in the directions element.  
        These are extra directions you are asking the system to understand
        as opposed to the verbs that translate to those directions. 
        The standard N,E,S,W etc directions are already built in, you only 
        need to use this tag if you wish to add any further directions. 
        <canonicalDirections directions="NNE|ENE|SSE|ESE|SSW|WSW|WNW|NNW"/>
    -->
           
    <directions defaultHandler="org.happysoft.games.action.handler.DirectionHandler">
        <defaultHelp>
            Move the player in the compass direction specified or UP or DOWN. 
        </defaultHelp>
        <direction direction="N" canonicalDirection="NORTH" display="North"/>
        <direction direction="E" canonicalDirection="EAST" display="East"/>
        <direction direction="S" canonicalDirection="SOUTH" display="South"/>
        <direction direction="W" canonicalDirection="WEST" display="West"/>
        <direction direction="NORTH" canonicalDirection="NORTH" display="North"/>
        <direction direction="EAST" canonicalDirection="EAST" display="East"/>
        <direction direction="SOUTH" canonicalDirection="SOUTH" display="South"/>
        <direction direction="WEST" canonicalDirection="WEST" display="West"/>
        <direction direction="NE" canonicalDirection="NORTHEAST" display="NorthEast"/>
        <direction direction="NW" canonicalDirection="NORTHWEST" display="NorthWest"/>
        <direction direction="SE" canonicalDirection="SOUTHEAST" display="SouthEast"/>
        <direction direction="SW" canonicalDirection="SOUTHWEST" display="SouthWest"/>
        <direction direction="NORTHEAST" canonicalDirection="NORTHEAST" display="NorthEast"/>
        <direction direction="NORTHWEST" canonicalDirection="NORTHWEST" display="NorthWest"/>
        <direction direction="SOUTHEAST" canonicalDirection="SOUTHEAST" display="SouthEast"/>
        <direction direction="SOUTHWEST" canonicalDirection="SOUTHWEST" display="SouthWest"/>
        <direction direction="UP" canonicalDirection="UP" display="Up"/>
        <direction direction="DOWN" canonicalDirection="DOWN" display="Down"/>
        <direction direction="U" canonicalDirection="UP" display="Up"/>
        <direction direction="D" canonicalDirection="DOWN" display="Down"/>
        <!-- 
        <direction direction="NNW" canonicalDirection="NNW" display="North by NorthWest"/>
        -->
    </directions>
    
    <renderers package="org.happysoft.games.renderers">
        <renderer type="DarkRoomRenderer" roomTags="dark" itemTagsNotPresent="light-source-active"/>
    </renderers>
    
    <interceptors>
        <interceptor actionHandler="DirectionHandler" roomTags="dark" itemTagsNotPresent="light-source-active" eventIds="20000"/>
        <interceptor verbs="GET|TAKE" itemTags="smelly|plural" eventIds="20001"/>
        <interceptor verbs="GET|TAKE" itemTags="smelly" eventIds="20002"/>
    </interceptors>
    
    <handlerSelectionRules package="org.happysoft.games.action.handler.rules">
        <rule name="CheckTargetObjectIsNotNull" implementation="TargetObjectIsNotNullRule"/>
        <rule name="CheckTargetObjectIsNull" implementation="TargetObjectIsNullRule"/>
        <rule name="CheckTargetObjectAcceptsItems" implementation="TargetObjectAcceptsItemsRule"/>
        <rule name="CheckTargetObjectIsLocal" implementation="TargetObjectIsLocalRule"/>
        <rule name="CheckTargetIsInFriendRoom" implementation="TargetObjectIsInFriendRoomRule"/>
        <rule name="NoMatch" implementation="NoMatchRule"/>
    </handlerSelectionRules>
        
    <ignoredWords>GO|THE|A|AN|SOME|OF|YOUR|ONE|TWO|FEW| | </ignoredWords>
    <pronouns>IT</pronouns>
    
    <verbs defaultPackage="org.happysoft.games.action.handler">
        <verb synonyms="LOOK|L" handler="AdverbHandler" acceptedPrepositions="AT|IN|WITH|USING|THROUGH">
            <help>
                LOOK; redescribe the current location
                LOOK UP [adjective] &lt;noun&gt; IN [adjective] &lt;noun&gt;; look something up in an index for example
                LOOK THROUGH [adjective] &lt;noun&gt; [AT [adjective] &lt;noun&gt;]; look through something at something else
                LOOK AT [adjective] &lt;noun&gt; WITH|USING [adjective] &lt;noun&gt;;
            </help>
            <adverbs defaultHandler="LookHandler">
                <adverb adverbs="AT" handler="ExamineHandler" itemTag="viewer">
                    <rules>
                        <!-- LOOK AT x THROUGH y --> 
                        <rule name="CheckTargetObjectIsNull" override="ExamineHandler"/>
                        <rule name="CheckTargetIsInFriendRoom" override="ItemActionListener" itemTag="viewable"/>
                        <rule name="CheckTargetObjectIsLocal" override="ItemActionListener" itemTag="magnifiable"/>
                        <rule name="NoMatch" override="DefaultHandler">You don't need :1 to do that.</rule>
                    </rules>
                </adverb>
                <adverb adverbs="UP" handler="DoTaskHandler"/>
                <adverb adverbs="THROUGH" handler="ExamineHandler" itemTag="viewer">                               
                    <rules>
                        <!-- LOOK THROUGH x AT y --> 
                        <rule name="CheckTargetObjectIsNull" override="ExamineHandler"/>
                        <rule name="CheckTargetIsInFriendRoom" override="ItemActionListener" itemTag="viewable"/>
                        <rule name="CheckTargetObjectIsLocal" override="ItemActionListener" itemTag="magnifiable"/>
                        <rule name="NoMatch" override="DefaultHandler">You don't need :1 to do that.</rule>
                    </rules>
                </adverb>
            </adverbs>
        </verb>
        <verb synonyms="ATTACK|KILL" handler="AttackHandler" acceptedPrepositions="WITH">
            <help>
                ATTACK &lt;npc&gt; [WITH [adjective] &lt;noun&gt;]; Attack an NPC optionally with a weapon, if WITH is not specified then you throw a punch
            </help>
        </verb>
        <verb synonyms="EXAMINE|EXAM|X" handler="ExamineHandler">
            <help>
                EXAM [adjective] &lt;noun&gt;; Show a more detailed description of an item (either in a location or a carried item)
                Use EXAM ALL to examine everything in the current location
            </help>
        </verb>
        <verb synonyms="INVENTORY|INV" handler="InventoryHandler">
            <help>
                INV; Lists items you are carrying
            </help>
        </verb> 
        <verb synonyms="GET" handler="TakeHandler" onCompleted="Taken">
            <help>
                GET [adjective] &lt;noun&gt;; GET an item from the current location. Use GET ALL to pick up all objects from the current location
                see also: TAKE, PUT, DROP
            </help>
        </verb>       
        <verb synonyms="TAKE" handler="AdverbHandler" acceptedPrepositions="OUT" onCompleted="Taken">
            <help>
                TAKE [adjective] &lt;noun&gt;; TAKE an item from the current location. Use TAKE ALL to pick up all objects from the current location
                TAKE [adjective] &lt;noun&gt; OUT OF [adjective] &lt;noun&gt;; Take one object out of another (aka REMOVE FROM)
                see also: GET, PUT, DROP
            </help>
            <adverbs defaultHandler="TakeHandler">
                <!-- PUT ON x (like WEAR) --> 
                <adverb adverbs="OFF" handler="ItemActionListener" itemTag="wearable"/>
                <!--
                    <rules>
                        Take x OFF y, maybe like HANG x ON y
                        <rule name="CheckTargetObjectIsNotNull" override="DoTaskHandler"/>	
                    </rules>
                </adverb>   
                -->
            </adverbs>
        </verb>
        <verb synonyms="DROP" handler="DropHandler" onCompleted="OK">
            <help>
                DROP [adjective] &lt;noun&gt;; leave an item in the current location
                see also: GET, TAKE, PUT
            </help>
        </verb>
        <verb synonyms="PUT" handler="AdverbHandler">
            <help>
                PUT [adjective] &lt;noun&gt;; IN|INTO [adjective] &lt;container&gt;; PUT an item in or into a container such as a cupboard or on a chair, etc 
                or you can use it in the more abstract sense to PUT an item IN|INTO something that uses it, like PUT BATTERIES IN TORCH or PUT PHOTO IN ALBUM
                PUT [adjective] &lt;noun&gt; ON [adjective] &lt;noun&gt;; PUT something ON something else like HANG x ON y or place an item on a table.
                PUT ON [adjective] &lt;noun&gt; like WEAR x (for a wearable item)
                See also: GET, TAKE
            </help>
            <adverbs defaultHandler="PutHandler">
                <!-- PUT ON x (like WEAR) --> 
                <adverb adverbs="ON" handler="ItemActionListener" itemTag="wearable">
                    <rules>
                        <!-- PUT x ON y, maybe like HANG x ON y --> 
                        <rule name="CheckTargetObjectIsNotNull" override="DoTaskHandler"/>
                    </rules>
                </adverb>
                <adverb adverbs="IN|INTO">
                    <rules>
                        <!-- PUT BATTERIES IN TORCH or fall back to PUT x IN CUPBOARD using PutHandler -->
                        <rule name="CheckTargetObjectAcceptsItems" override="ItemAcceptsObjectHandler"/>
                    </rules>
                </adverb>
            </adverbs>
        </verb>
        <verb synonyms="SELL" handler="SellHandler" acceptedPrepositions="TO">
            <help>
                SELL [adjective] &lt;noun&gt; TO &lt;npc&gt;; Sell an item to an NPC. Note that you may want to SHOW first to find out how much they'll give you for it 
                see also: SHOW, BUY, SWAP, GIVE
            </help>
        </verb>
        <verb synonyms="SWAP|EXCHANGE|OFFER" handler="SwapHandler" acceptedPrepositions="FOR">
            <help>
                SWAP [adjective] &lt;noun&gt; FOR [adjective] &lt;noun&gt;; Ask an NPC to swap something you're carrying for something they possess
                see also: BUY, SELL, SHOW, GIVE
            </help>
        </verb>
        <verb synonyms="BUY" handler="BuyHandler" acceptedPrepositions="FROM">
            <help>
                BUY [adjective] &lt;noun&gt; [FROM &lt;npc&gt;]; Buy an offered item from an NPC
                see also: SELL, SWAP, SHOW, GIVE
            </help>
        </verb>
        <verb synonyms="WAIT|WA" handler="WaitHandler" acceptedPrepositions="UNTIL" onCompleted="... Time passes ...">
            <help>
                WAIT mm; WAIT for the specified number of minutes or WAIT UNTIL hh:mm; 
                WAIT UNTIL the specified time
                see also TIME
            </help>
        </verb>
        <verb synonyms="TIME" handler="TimeHandler">
            <help>
                TIME; show the current in-game time
            </help>
        </verb>
        <verb synonyms="SAVE" handler="SaveHandler">
            <help>
                SAVE &quot;&lt;filename&gt;&quot;; save your current game progress
            </help>
        </verb>
        <verb synonyms="LOAD" handler="LoadHandler">
            <help>
                LOAD &quot;&lt;filename&gt;&quot;; load a previously saved game
            </help>
        </verb>
        <verb synonyms="QUIT" handler="QuitHandler">
            <help>
                QUIT; quit and start again
            </help>
        </verb>
        <verb synonyms="HELP" handler="HelpHandler">
            <help>
                HELP; show this message
            </help>
        </verb>
        <verb synonyms="SCORE" handler="ScoreHandler">
            <help>
                SCORE; show your current score
            </help>
        </verb>
        
        <!-- Task specific verbs -->
        <verb synonyms="ASK" handler="DoTaskHandler" acceptedPrepositions="ABOUT">
            <help>
                ASK &lt;npc&gt; ABOUT [adjective] &lt;noun&gt;; Ask an Npc about an object (topic)
            </help>
        </verb>        
        <verb synonyms="ATTACH" handler="DoTaskHandler" acceptedPrepositions="TO">
            <help>
                ATTACH [adjective] &lt;noun&gt; TO [adjective] &lt;noun&gt;; Attach a carried item to another object
            </help>
        </verb>
        <verb synonyms="BOLT" handler="DoTaskHandler">
            <help>
                BOLT [adjective] &lt;noun&gt;; BOLT a door or window
            </help>
        </verb>
        <verb synonyms="CALL" handler="DoTaskHandler">
            <help>
                CALL &lt;npc&gt;; CALL an NPC. Attract their attention? More for inanimate objects like LIFTS that may be modelled as an NPC
            </help>
        </verb>
        <verb synonyms="CLOSE" handler="DoTaskHandler">
            <help>
                CLOSE [adjective] &lt;noun&gt;; close a door or a container such as a drawer or a cupboard
            </help>
        </verb>
        <verb synonyms="COMPARE|MATCH" handler="DoTaskHandler" acceptedPrepositions="AGAINST|WITH">
            <help>
                COMPARE [adjective] &lt;noun&gt; WITH|AGAINST [adjective] &lt;noun&gt;; compare one thing against another
            </help>
        </verb>
        <verb synonyms="DETACH" handler="DoTaskHandler" acceptedPrepositions="FROM">
            <help>
                DETACH [adjective] &lt;noun&gt; FROM [adjective] &lt;noun&gt;; Detach an item from another object
            </help>
        </verb>
        <verb synonyms="GIVE" handler="DoTaskHandler" acceptedPrepositions="TO">
            <help>
                GIVE [adjective] &lt;noun&gt; TO &lt;npc&gt;; Give an item to an NPC, they may not be interested though
                see also: BUY, SWAP, SELL, SHOW
            </help>
        </verb>
        <verb synonyms="INSERT" handler="DoTaskHandler" acceptedPrepositions="IN|INTO">
            <help>
                INSERT [adjective] &lt;noun&gt; INTO [adjective] &lt;noun&gt;; Insert an item into another item 
            </help>
        </verb>
        <verb synonyms="JEMMY|JEMMIE|PRISE|SMASH" handler="DoTaskHandler" acceptedPrepositions="WITH|USING">
            <help>
                JEMMY [adjective] &lt;noun&gt; WITH|USING [adjective] &lt;noun&gt;; Jemmy or smash something open (e.g. lock, window, door)
            </help>
        </verb>
        <verb synonyms="LOCK" handler="DoTaskHandler" acceptedPrepositions="WITH|USING">
            <help>
                LOCK [adjective] &lt;noun&gt; WITH [adjective] &lt;noun&gt;; e.g. LOCK STEEL DOOR WITH GOLD KEY
            </help>
        </verb>
        <verb synonyms="OPEN" handler="DoTaskHandler">
            <help>
                OPEN [adjective] &lt;noun&gt;; e.g. open a door or a container such as a drawer or a cupboard
            </help>
        </verb>
        <verb synonyms="PAY" handler="DoTaskHandler">
            <help>
                PAY &lt;npc&gt;; PAY an NPC. The amount to pay should be clear from the context so you don't need to specify the amount
            </help>
        </verb>
        <verb synonyms="PICK" handler="AdverbHandler" acceptedPrepositions="WITH|USING">
            <help>
                PICK [adjective] &lt;noun&gt; WITH|USING [adjective] &lt;noun&gt; PICK a lock etc
                PICK UP [adjective] &lt;noun&gt;; Another synonym for GET|TAKE 
            </help>
            <adverbs defaultHandler="DoTaskHandler">
                <adverb adverbs="UP" handler="TakeHandler"/>
            </adverbs>
        </verb>
        <verb synonyms="PLUG" handler="DoTaskHandler" acceptedPrepositions="INTO">
            <help>
                PLUG [adjective] &lt;noun&gt;; INTO [adjective] &lt;noun&gt;; A synonym for ATTACH
            </help>
        </verb>
        <verb synonyms="PRESS" handler="DoTaskHandler">
            <help>
                PRESS [adjective] &lt;noun&gt;; Press on an object, e.g. Press the button to call a lift
            </help>
        </verb>
        <verb synonyms="REMOVE" handler="DoTaskHandler" acceptedPrepositions="FROM">
            <help>
                REMOVE [adjective] &lt;noun&gt;; REMOVE one object FROM another
            </help>
        </verb>         
        <!--    
        <verb synonyms="RUN" handler="AdverbHandler">
            <help>
                RUN somewhere instead of walking, this reduces the time taken to get to a destination. Use RUN &lt;compass direction&gt;
            </help>
            <adverbs defaultHandler="DirectionHandler">
                <adverb adverbs="N|E|S|W|NE|NW|SE|SW|NORTH|SOUTH|EAST|WEST|NORTHEAST|NORTHWEST|SOUTHEAST|SOUTHWEST|U|D|UP|DOWN" parameters="0.5"/>
            </adverbs>
        </verb>    
        -->
        <verb synonyms="SAY" handler="DoTaskHandler" hint="You only need to SAY something in certain locations.">
            <help>
                SAY &quot;&lt;quoted text&gt;&quot;; Say something, e.g. a password (SAY TO is not supported yet).
            </help>
        </verb>
        <verb synonyms="SHOW" handler="ShowHandler" acceptedPrepositions="TO">
            <help>
                SHOW [adjective] &lt;noun&gt; TO &lt;npc&gt;; Show a carried item to an NPC. If the NPC is a trader they will give you a price for it.  
            </help>
        </verb>
        <verb synonyms="SWITCH|TURN" handler="AdverbHandler">
            <help>
                SWITCH ON|OFF [adjective] &lt;noun&gt;; SWITCH an object ON or OFF
            </help>
            <adverbs>
                <adverb adverbs="ON" handler="ItemActionListener" itemTag="activatable" itemTagFailureText="Is it on already?"/>
                <adverb adverbs="OFF" handler="ItemActionListener" itemTag="deactivatable" itemTagFailureText="Is it currently off?"/>
            </adverbs>
        </verb>
        <verb synonyms="THROW" handler="DoTaskHandler" acceptedPrepositions="AT">
            <help>
                THROW [adjective] &lt;noun&gt; AT [adjective] &lt;noun&gt;; THROW a carried item AT another object
            </help>
        </verb>
        <verb synonyms="UNLOCK" handler="DoTaskHandler" acceptedPrepositions="WITH|USING" hint="Try UNLOCK &lt;object&gt; WITH &lt;key&gt; if you have the right key.">
            <help>
                UNLOCK [adjective] &lt;noun&gt; WITH|USING [adjective] &lt;noun&gt;; for example UNLOCK DOOR USING KEY
            </help>
        </verb>        
        <verb synonyms="UNBLOCK" handler="DoTaskHandler" acceptedPrepositions="WITH|USING">
            <help>
                UNBLOCK [adjective] &lt;noun&gt; WITH|USING [adjective] &lt;noun&gt;; UNBLOCK something, e.g. a drain USING an implement
            </help>
        </verb>
        <verb synonyms="UNBOLT" handler="DoTaskHandler">
            <help>
                UNBOLT [adjective] &lt;noun&gt;; UNBOLT a door or window
            </help>
        </verb>
        <verb synonyms="UNPLUG" handler="DoTaskHandler" acceptedPrepositions="FROM">
            <help>
                UNPLUG [adjective] &lt;noun&gt; FROM [adjective] &lt;noun&gt;; UNPLUG an item FROM an object
            </help>
        </verb>
        <verb synonyms="WEAR" handler="ItemActionListener" itemTag="wearable">
            <help>
                WEAR [adjective] &lt;noun&gt;; WEAR an item
            </help>
        </verb>   
    </verbs>
    
</game>


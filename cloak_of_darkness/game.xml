<?xml version="1.0" encoding="UTF-8"?>
<game debug="false">
    <welcome>
        Cloak of Darkness
        A basic X-TADS demonstration.
    </welcome> 
    <player inventory="-101|3" startRoom="1" timeout="5" skiptime="10" hp="100" onDeathEvent="500000"/>    
    
    <currency major="Dollars" minor="Cents" symbol="$" initialBalance="0"/>
    <gameClock type="24" startTime="13:00"/>
    
    <renderers package="org.happysoft.games.renderers">
        <renderer type="DarkRoomRenderer" roomTag="dark" itemTagsNotPresent="light-source-active"/>
    </renderers>
    
    <handlerSelectionRules package="org.happysoft.games.action.handler.rules">
        <rule name="CheckTargetObjectNotNull" implementation="TargetObjectNotNullRule"/>
        <rule name="CheckTargetAcceptsItems" implementation="TargetObjectAcceptsItemsRule"/>
    </handlerSelectionRules>
    
    <ignoredWords>GO|THE|A|AN|SOME|OF|YOUR|ONE|TWO|FEW| | </ignoredWords>
    <pronouns>IT</pronouns>
    
    <verbs defaultPackage="org.happysoft.games.action.handler">
        <verb synonyms="N|E|S|W|NE|NW|SE|SW|NORTH|SOUTH|EAST|WEST|NORTHEAST|NORTHWEST|SOUTHEAST|SOUTHWEST|U|D|UP|DOWN" handler="DirectionHandler" parameters="1.0">
            <help>
                Move from the current location in the compass direction specified or Up or Down
            </help>
        </verb>
        <verb synonyms="LOOK" handler="AdverbHandler" acceptedPrepositions="IN|AT">
            <help>
                LOOK; redescribe the current location
                LOOK UP [adjective] &lt;noun&gt; IN [adjective] &lt;noun&gt;; look something up in an index for example
            </help>
            <adverbs defaultHandler="LookHandler">
                <adverb adverbs="UP" handler="DoTaskHandler"/>
                <adverb adverbs="THROUGH" handler="DoTaskHandler"/>
            </adverbs>
        </verb>
        <verb synonyms="ATTACK|KILL" handler="AttackHandler" acceptedPrepositions="WITH">
            <help>
                ATTACK &lt;npc&gt; [WITH [adjective] &lt;noun&gt;]; Attack an NPC optionally with a weapon, if WITH is not specified then you throw a punch
            </help>
        </verb>
        <verb synonyms="EXAMINE|EXAM|X" handler="ExamineHandler">
            <help>
                EXAM [adjective] &lt;noun&gt;; Show a more detailed description of an item (either in a location or a carried item)
                Use EXAM ALL to examine everything in the current location
            </help>
        </verb>
        <verb synonyms="INVENTORY|INV" handler="InventoryHandler">
            <help>
                INV; Lists items you are carrying
            </help>
        </verb> 
        <verb synonyms="GET" handler="TakeHandler" onCompleted="Taken">
            <help>
                GET [adjective] &lt;noun&gt;; GET an item from the current location. Use GET ALL to pick up all objects from the current location
                see also: TAKE, PUT, DROP
            </help>
        </verb>       
        <verb synonyms="DROP" handler="DropHandler" onCompleted="OK">
            <help>
                DROP [adjective] &lt;noun&gt;; leave an item in the current location
                see also: GET, TAKE, PUT
            </help>
        </verb>
        <verb synonyms="PUT" handler="AdverbHandler" acceptedPrepositions="IN|INTO" onCompleted="OK" itemTag="wearable">
            <help>
                PUT [adjective] &lt;noun&gt;; IN|INTO [adjective] &lt;container&gt;; PUT an item in or into a container such as a cupboard or on a chair, etc 
                or you can use it in the more abstract sense to PUT an item IN|INTO something that uses it, like PUT BATTERIES IN TORCH or PUT PHOTO IN ALBUM
                see also: GET, TAKE, PUT
                PUT [adjective] &lt;noun&gt; ON [adjective] &lt;noun&gt;; PUT something ON something else. 
            </help>
            <adverbs defaultHandler="PutHandler">
                <adverb adverbs="ON" handler="ItemActionListener">
                    <rules>
                        <rule name="CheckTargetObjectNotNull" override="DoTaskHandler"/>	
                    </rules>
                </adverb>
            </adverbs>
        </verb>
        <verb synonyms="SELL" handler="SellHandler" acceptedPrepositions="TO">
            <help>
                SELL [adjective] &lt;noun&gt; TO &lt;npc&gt;; Sell an item to an NPC. Note that you may want to SHOW first to find out how much they'll give you for it 
                see also: SHOW, BUY, SWAP, GIVE
            </help>
        </verb>
        <verb synonyms="SWAP|EXCHANGE|OFFER" handler="SwapHandler" acceptedPrepositions="FOR">
            <help>
                SWAP [adjective] &lt;noun&gt; FOR [adjective] &lt;noun&gt;; Ask an NPC to swap something you're carrying for something they possess
                see also: BUY, SELL, SHOW, GIVE
            </help>
        </verb>
        <verb synonyms="BUY" handler="BuyHandler" acceptedPrepositions="FROM">
            <help>
                BUY [adjective] &lt;noun&gt; [FROM &lt;npc&gt;]; Buy an offered item from an NPC
                see also: SELL, SWAP, SHOW, GIVE
            </help>
        </verb>
        <verb synonyms="WAIT|WA" handler="WaitHandler" acceptedPrepositions="UNTIL" onCompleted="... Time passes ...">
            <help>
                WAIT mm; WAIT for the specified number of minutes or WAIT UNTIL hh:mm; 
                WAIT UNTIL the specified time
                see also TIME
            </help>
        </verb>
        <verb synonyms="TIME" handler="TimeHandler">
            <help>
                TIME; show the current in-game time
            </help>
        </verb>
        <verb synonyms="SAVE" handler="SaveHandler">
            <help>
                SAVE &quot;&lt;filename&gt;&quot;; save your current game progress
            </help>
        </verb>
        <verb synonyms="LOAD|RESTORE" handler="LoadHandler">
            <help>
                LOAD &quot;&lt;filename&gt;&quot;; load a previously saved game
            </help>
        </verb>
        <verb synonyms="QUIT" handler="QuitHandler">
            <help>
                QUIT; quit and start again
            </help>
        </verb>
        <verb synonyms="HELP" handler="HelpHandler">
            <help>
                HELP; show this message
            </help>
        </verb>
        <verb synonyms="SCORE" handler="ScoreHandler">
            <help>
                SCORE; show your current score
            </help>
        </verb>
        
        <!-- Task specific verbs -->     
        <verb synonyms="HANG" handler="DoTaskHandler" acceptedPrepositions="ON">
            <help>
                HANG [adjective] &lt;noun&gt; ON [adjective] &lt;noun&gt;; Hang somehing on something.  
            </help>
        </verb>
        <verb synonyms="READ" handler="DoTaskHandler">
            <help>
                READ [adjective] &lt;noun&gt;; READ something
            </help>
        </verb> 
        <verb synonyms="TAKE" handler="AdverbHandler" acceptedPrepositions="OUT" itemTag="wearable">
            <help>
                TAKE 
                TAKE [adjective] &lt;noun&gt; OUT OF &lt;container&gt;
                TAKE OFF [adjective] &lt;noun&gt;; TAKE OFF an item of clothing.
            </help>
            <adverbs defaultHandler="TakeHandler">
                <adverb adverbs="OFF" handler="ItemActionListener"/>
            </adverbs>
        </verb> 
        <verb synonyms="WEAR" handler="ItemActionListener" itemTag="wearable">
            <help>
                WEAR [adjective] &lt;noun&gt;; WEAR an item of clothing.
            </help>
        </verb> 
    </verbs>
    
</game>

